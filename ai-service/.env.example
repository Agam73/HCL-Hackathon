# Copy to .env and fill in secrets. Never commit .env.

# PostgreSQL (Supabase or local pgvector-enabled PostgreSQL)
# Supabase: copy the connection string from Project Settings > Database > Connect.
# Keep sslmode=require in the URL and URL-encode special password characters.
DATABASE_SSLMODE=require
DATABASE_CONNECT_TIMEOUT=10
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=5
DATABASE_URL=postgresql://retailpulse:retailpulse@127.0.0.1:5432/retailpulse

# Shared secret Express must send as: Authorization: Bearer <key>
AI_SERVICE_API_KEY=change-me-to-a-long-random-string

# mock | openai | gemini
# mock: no API key, lexical-hash embeddings + deterministic JSON (tests / first boot)
# openai: OpenAI or any OpenAI-compatible /v1 API
# gemini: Google Gemini native API (uses MODEL_API_KEY)
CHAT_MODEL_PROVIDER=mock
CHAT_MODEL_NAME=gpt-4o-mini
EMBEDDING_MODEL_PROVIDER=mock
EMBEDDING_MODEL_NAME=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
MODEL_API_KEY=
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_RETRIES=2

# Chunking (character sizes ≈ tokens * 4 for English prose)
CHUNK_SIZE_CHARS=2400
CHUNK_OVERLAP_CHARS=400

# Retrieval — calibrate min score on real questions; do not treat the default as universal
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.15
CONFIDENCE_HIGH_SCORE=0.45
CONFIDENCE_MEDIUM_SCORE=0.25

MAX_UPLOAD_BYTES=10485760
ENABLE_RETRIEVE_DEBUG=true
LOG_LEVEL=INFO
