# ---- Server ----
NODE_ENV=development
PORT=8080
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Database (matches docker-compose.yml) ----
DATABASE_URL=postgresql://retailpulse:retailpulse@localhost:5432/retailpulse
PGSSL=false

# ---- Auth ----
# CHANGE THIS. Any long random string works for the hackathon.
JWT_SECRET=dev-only-change-me-7f3a9c1e5b2d4086
# Short-lived access token; the client renews it with the refresh token.
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7
BCRYPT_ROUNDS=10

# ---- Admin PCs ----
# Admin machines are locked down physically and open the admin portal without a login.
# Only these client IPs may do that (comma separated). Everyone else is refused.
ADMIN_TRUSTED_IPS=127.0.0.1,::1
# The ADMIN account those machines act as.
ADMIN_DEVICE_EMAIL=admin@novamart.com

# ---- Seed ----
# Password given to every seeded user (login with any email from db/seed/customers.csv)
SEED_DEFAULT_PASSWORD=Passw0rd!

# ---- RAG / embeddings (Module 2 - owner of that module fills these in) ----
# Dimension must match the schema's vector(N) column. Change both together.
EMBEDDING_DIM=1536
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=
GEMINI_API_KEY=
